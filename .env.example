# devclaw — per-machine defaults. Real env vars win over this file.
# Every variable, with its default, is documented in docs/reference/env-vars.md.

# DEVCLAW_TRANSPORT=stdio
# DEVCLAW_PORT=8000
# DEVCLAW_TOKEN=
# DEVCLAW_DB=./devclaw.db
# DEVCLAW_ENGINE=            # unset = docker sandbox; host; stub
# DEVCLAW_SANDBOX_IMAGE=devclaw-sandbox:latest
# DEVCLAW_MAX_CONCURRENT=4
# DEVCLAW_GOAL_SESSIONS_PER_DAY=8
# DEVCLAW_MENTION=@devclaw
# DEVCLAW_GOAL_NOTIFY_URL=
# DEVCLAW_SELF_REPO=
# DEVCLAW_GIT_NAME=devclaw
# DEVCLAW_GIT_EMAIL=devclaw@local
