#!/usr/bin/env bash
# What CI gates on a PR (.github/workflows/ci.yml): the stubbed pytest suite
# plus ruff + mypy + import-linter + yamllint, and the Angular console's lint,
# unit tests, build and chrome check (frontend/). Keep it honest — a check CI
# runs that this script skips is a red CI later.
#
# Deliberately NOT here, with reason:
#   gitleaks — downloads a pinned binary from the network; a sandbox without
#              egress would read a network flake as a secrets finding.
#   frontend e2e — needs browser bits the sandbox image does not carry; CI runs
#              it (`npx playwright install --with-deps chromium`). To drive it
#              here anyway: the Playwright Chromium needs libXfixes.so.3, which
#              is absent and cannot be apt-installed without root (extract it
#              from the Debian package into a scratch dir and point
#              LD_LIBRARY_PATH at it). That gets `playwright test` running, but
#              quality.spec.ts's `impeccable` scan still fails — it launches its
#              OWN Chrome, and this host restricts unprivileged user namespaces
#              ("No usable sandbox!"). So the most a sandbox run proves is
#              "everything but impeccable".
set -euo pipefail

cd "$(dirname "$0")/.."

# The gates below are the dev extras (CI: `install: -e '.[dev]'`). The deployed
# devclaw image installs the RUNTIME deps only (deploy/Dockerfile:
# `pip install .`), so a session running INSIDE the devclaw container used to
# die on the first line with "No module named pytest" — a script that cannot
# run is a script that lies. Bootstrap them into a worktree-local .venv, the
# same shape `.no-mistakes.yaml`'s `prepare` step already uses (it reuses this
# .venv), and leave a host that already has them untouched.
if ! python3 -c "import pytest, pytest_asyncio, xdist, ruff, mypy, importlinter, yamllint" 2>/dev/null; then
  [ -x .venv/bin/python ] || python3 -m venv .venv
  .venv/bin/python -m pip install -q -e '.[dev]'
  export PATH="$PWD/.venv/bin:$PATH"
fi

# /tmp/pytest-of-<user> can be root-owned on some hosts, which crashes every
# tmp_path fixture — give the run a private basetemp.
export TMPDIR="${TMPDIR:-$(mktemp -d)}"

# pyproject sets `-n auto`, which reads the HOST's nproc, not the sandbox's
# cgroup limit — an unbounded xdist fan-out is what gets a run OOM-killed.
workers="${DEVCLAW_SANDBOX_CPUS:-2}"
workers="${workers%%.*}"
[ -z "$workers" ] && workers=2

python3 -m pytest -q -n "$workers"
python3 -m ruff check .
python3 -m mypy
lint-imports
yamllint \
  -d '{extends: default, rules: {line-length: disable, document-start: disable, truthy: disable}}' \
  .github/workflows/

# The console (frontend/): @lifekit-hq/* installs from GitHub Packages with
# NODE_AUTH_TOKEN, which the sandbox carries (devclaw/credentials.py).
cd frontend
npm ci --no-audit --no-fund
npm run lint
npm test
npm run build
npx lifekit-chrome-check --app dc --name devclaw --base-path /console/ ../devclaw/server/console_dist
