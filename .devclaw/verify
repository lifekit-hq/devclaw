#!/usr/bin/env bash
# What CI gates on a PR (.github/workflows/ci.yml): the stubbed pytest suite
# plus ruff + mypy + import-linter + yamllint, and the Angular console's lint,
# unit tests, build and chrome check (frontend/). Keep it honest — a check CI
# runs that this script skips is a red CI later.
#
# Deliberately NOT here, with reason:
#   gitleaks — downloads a pinned binary from the network; a sandbox without
#              egress would read a network flake as a secrets finding.
#   frontend e2e — Playwright drives a downloaded Chromium that needs system
#              libraries the sandbox image does not carry; CI runs it.
set -euo pipefail

cd "$(dirname "$0")/.."

# /tmp/pytest-of-<user> can be root-owned on some hosts, which crashes every
# tmp_path fixture — give the run a private basetemp.
export TMPDIR="${TMPDIR:-$(mktemp -d)}"

# pyproject sets `-n auto`, which reads the HOST's nproc, not the sandbox's
# cgroup limit — an unbounded xdist fan-out is what gets a run OOM-killed.
workers="${DEVCLAW_SANDBOX_CPUS:-2}"
workers="${workers%%.*}"
[ -z "$workers" ] && workers=2

python3 -m pytest -q -n "$workers"
python3 -m ruff check .
python3 -m mypy
lint-imports
yamllint \
  -d '{extends: default, rules: {line-length: disable, document-start: disable, truthy: disable}}' \
  .github/workflows/

# The console (frontend/): @lifekit-hq/* installs from GitHub Packages with
# NODE_AUTH_TOKEN, which the sandbox carries (devclaw/credentials.py).
cd frontend
npm ci --no-audit --no-fund
npm run lint
npm test
npm run build
npx lifekit-chrome-check --app dc --name devclaw --base-path /console/ ../devclaw/server/console_dist
