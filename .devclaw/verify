#!/usr/bin/env bash
# What CI gates on a PR (.github/workflows/ci.yml): the stubbed pytest suite
# plus ruff + mypy + import-linter + yamllint, and the Angular console's lint,
# unit tests, build, demo build and chrome check (frontend/). Keep it honest —
# a check CI runs that this script skips is a red CI later.
#
# Deliberately NOT here, with reason:
#   gitleaks — downloads a pinned binary from the network; a sandbox without
#              egress would read a network flake as a secrets finding.
#   frontend e2e — the screen check, the route scan (which downloads its
#              pinned impeccable detector) and the screen baselines. CI owns it
#              (`npx playwright install --with-deps chromium`). In the worker
#              container the browser's system libraries are installed
#              (deploy/Dockerfile), so Playwright's own Chromium launches
#              (Playwright starts it with --no-sandbox). A browser a test
#              launches itself, from one executable path (the route scan's
#              impeccable detector, wired in playwright.config.ts), goes through the image's chromium-no-sandbox
#              wrapper (DEVCLAW_CHROMIUM_NO_SANDBOX, set in that image only): the
#              container's default seccomp profile withholds the user namespaces
#              Chromium's sandbox needs, so the container is the boundary. A session
#              can therefore run the e2e (`npm run e2e`) in the worker, scan
#              included. A documentation-only diff runs with DEVCLAW_DOCS_ONLY=1
#              (a script that honours it skips the browser e2e).
set -euo pipefail

cd "$(dirname "$0")/.."

# The gates below are the dev extras (CI: `install: -e '.[dev]'`). The deployed
# devclaw image installs the RUNTIME deps only (deploy/Dockerfile:
# `pip install .`), so a session running INSIDE the devclaw container used to
# die on the first line with "No module named pytest" — a script that cannot
# run is a script that lies. Bootstrap them into a worktree-local .venv, the
# same shape `.no-mistakes.yaml`'s `prepare` step already uses (it reuses this
# .venv).
#
# The probe asks for every name pyproject DECLARES — the runtime deps as well
# as the dev extra, by distribution name (importlib.metadata normalizes, so
# there is no module-name table to drift out of step). Both halves matter: a
# new dev extra must not be skipped by a .venv that predates it (it would pass
# the probe and then die at pytest collection on a missing plugin), and an
# install cut short mid-run — watchdog, OOM, SIGTERM — can leave the dev tools
# present and `fastmcp` gone, which every devclaw/server/tools module imports
# at collection.
probe='import re, tomllib, importlib.metadata as md
project = tomllib.load(open("pyproject.toml", "rb"))["project"]
for dep in project["dependencies"] + project["optional-dependencies"]["dev"]:
    md.distribution(re.split(r"[<>=!~;\[ ]", dep)[0])'

if [ -x .venv/bin/python ] && .venv/bin/python -c "$probe" 2>/dev/null; then
  # Complete: a repeat round (each `--resume` of the verify loop) is a probe
  # and a PATH prepend, never a trip to the package index.
  export PATH="$PWD/.venv/bin:$PATH"
elif python3 -c "$probe" 2>/dev/null && [ ! -e .venv ]; then
  :  # the host already carries the extras and nothing shadows them
else
  # An interpreter that RUNS is topped up in place — the probe fails for an
  # incomplete env too (a dep added since the venv was built), and rebuilding
  # that one would pull every declared distribution back from the index inside
  # the verify timeout. Anything else is replaced: a tree with no usable
  # interpreter (half-created, or a dangling bin/python that `venv` will not
  # re-link because the symlink exists), or a plain file on the path, both of
  # which otherwise kill the script under `set -e` before the first gate with
  # no remedy anywhere in the output the session gets back. (`.no-mistakes.yaml`'s
  # `prepare` builds the same .venv and has not learned this; it is covered
  # only because verify runs first and repairs the tree.)
  # `pip --version` as well as a bare start: an interpreter that runs with no
  # pip module (a `pip` self-upgrade cut short) would otherwise be topped up
  # by a `pip` that cannot be imported — exit 1 before the first gate, with
  # the tree left in place so every later round repeats it. Rebuilding
  # restores pip via ensurepip.
  if [ -x .venv/bin/python ] && .venv/bin/python -c "" 2>/dev/null \
     && .venv/bin/python -m pip --version >/dev/null 2>&1; then
    :
  else
    if [ -e .venv ] || [ -L .venv ]; then rm -rf .venv; fi  # -e misses a dangling link
    python3 -m venv .venv
  fi
  .venv/bin/python -m pip install -q -e '.[dev]'
  export PATH="$PWD/.venv/bin:$PATH"
fi

# /tmp/pytest-of-<user> can be root-owned on some hosts, which crashes every
# tmp_path fixture — give the run a private basetemp.
export TMPDIR="${TMPDIR:-$(mktemp -d)}"

# pyproject sets `-n auto`, which reads the HOST's nproc, not the sandbox's
# cgroup limit — an unbounded xdist fan-out is what gets a run OOM-killed.
workers="${DEVCLAW_SANDBOX_CPUS:-2}"
workers="${workers%%.*}"
[ -z "$workers" ] && workers=2

python3 -m pytest -q -n "$workers"
python3 -m ruff check .
python3 -m mypy
lint-imports
yamllint \
  -d '{extends: default, rules: {line-length: disable, document-start: disable, truthy: disable}}' \
  .github/workflows/

# The console (frontend/): @lifekit-hq/* installs from GitHub Packages with
# NODE_AUTH_TOKEN, which the sandbox carries (devclaw/credentials.py).
cd frontend
npm ci --no-audit --no-fund
npm run lint
npm test
npm run build
npm run build:demo
npx lifekit-chrome-check --app dc --name devclaw --base-path /console/ ../devclaw/server/console_dist
