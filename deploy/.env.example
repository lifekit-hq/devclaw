# /srv/devclaw/.env — devclaw's OWN deploy-time env file (template).
#
# Copy to /srv/devclaw/.env on the VPS, fill in, chmod 600. Read by
# deploy/deploy-devclaw.sh + deploy/docker-compose.devclaw.yml and by nothing
# else. devclaw never reads another entity's env file, and no other entity
# reads this one (ecosystem decoupling). The LIFEKIT_* values are HOST FACTS —
# facts about this VPS, not app config — duplicated into each entity's env
# file on purpose.
#
# Runtime env vars the devclaw process itself reads are documented in
# docs/reference/env-vars.md; this file only carries what the compose fragment
# substitutes at deploy time.

# ─── Credentials: NOT here ───────────────────────────────────────────────────
# CLAUDE_CODE_OAUTH_TOKEN and NODE_AUTH_TOKEN live in /srv/devclaw/secrets.env
# (mode 0600, owned by the deploy user) — the env_file the compose fragment
# declares. deploy/deploy-devclaw.sh writes it from the repo Actions secrets on
# every workflow deploy and reads it back on a hand run; every `docker compose
# up` from the box reads the same file. One-time provisioning:
#   sudo install -m 0600 -o lifekit -g lifekit /dev/null /srv/devclaw/secrets.env
# A line HERE would be ignored: the fragment no longer interpolates them.

# ─── Host facts ──────────────────────────────────────────────────────────────
# GID of the host `docker` group — lets the non-root container user spawn
# sandbox containers via the mounted socket. `getent group docker | cut -d: -f3`
LIFEKIT_DOCKER_GID=990
# Claude Code OAuth session of the host deploy user (no API key, ever).
LIFEKIT_CLAUDE_HOME=/home/lifekit/.claude
LIFEKIT_CLAUDE_JSON=/home/lifekit/.claude.json
# gh CLI auth + gitconfig (private clones, PR creation, commit authorship).
LIFEKIT_GH_CONFIG=/home/lifekit/.config/gh
LIFEKIT_GITCONFIG=/home/lifekit/.gitconfig
# The memory vault (read-only trend/self-reflection reads).
LIFEKIT_LIFE_DIR=/srv/memory
# Host path bind-mounted as the workspaces root — MUST be a host path docker
# can re-bind into spawned sandbox containers.
LIFEKIT_DEVCLAW_WORKSPACES=/srv/devclaw/workspaces
# ops-agent incident output dir (create + chown 1000:1000 first, see runbook).
LIFEKIT_OPS_AGENT_DIR=/srv/memory/projects/ops-agent

# ─── Durable state (goal-safety) ─────────────────────────────────────────────
# Real name of the external devclaw-state volume. On the cutover host the
# pre-existing volume is `compose_devclaw-state` — adopt it in place. A fresh
# host omits this line (default `devclaw-state`, created with
# DEVCLAW_ALLOW_VOLUME_CREATE=1).
#DEVCLAW_STATE_VOLUME=compose_devclaw-state

# ─── Operator knobs (optional — fragment defaults apply when unset) ──────────
OPENCLAW_TZ=Europe/London
#DEVCLAW_NOTIFY_ALTITUDE=task
#DEVCLAW_GOAL_AUTOMERGE=0
#DEVCLAW_SELF_REPO=lifekit-hq/devclaw
#DEVCLAW_SELF_ISSUE_MIN_CYCLES=2
# Sandbox sizing (docs/reference/env-vars.md). The 2g memory default cannot
# hold the in-sandbox agent plus a heavy verify run (e.g. an Angular ng test
# suite) — size to the host; the admission brake (DEVCLAW_COGNITION_MEM_RESERVE)
# keeps N containers from overcommitting the box.
#DEVCLAW_SANDBOX_MEMORY=2g
#DEVCLAW_SANDBOX_CPUS=2.0
#DEVCLAW_COGNITION_MEM_RESERVE=1536m

# ─── ops-agent ───────────────────────────────────────────────────────────────
# Bearer token ops-agent uses to call devclaw-mcp over the shared network.
DEVCLAW_TOKEN=
# Image is BUILT by lifekit-stack (build-only profile) and run here.
#OPS_AGENT_IMAGE=ops-agent:local
