{
  "name": "devclaw-frontend",
  "private": true,
  "version": "0.9.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:demo": "ng build -c production,demo && cp dist/demo/index.html dist/demo/404.html && perl -pi -e 's{\"/console/\"}{\"/devclaw/\"}g' dist/demo/manifest.webmanifest",
    "lint": "lifekit-theme-sync --check && npm run drift && ng lint --max-warnings 0",
    "drift": "lifekit-chrome-check drift src public",
    "sync:theme": "lifekit-theme-sync",
    "test": "ng test --no-watch",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/service-worker": "^21.2.25",
    "@lifekit-hq/core": "^4.1.0",
    "@lifekit-hq/elements": "^4.1.0",
    "@lifekit-hq/tokens": "^4.1.0",
    "@lifekit-hq/ui": "^4.1.0",
    "@ngrx/signals": "^21.1.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@lifekit-hq/config": "^4.1.0",
    "@playwright/test": "1.62.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^24.12.3",
    "@vitest/browser-playwright": "^4.1.10",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.10"
  }
