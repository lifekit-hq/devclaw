# Keep the docker build context lean for deploy/Dockerfile (it builds from the
# repo root). Do NOT exclude frontend/ (the MCP image builds the console from
# it).

.git
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Reinstalled fresh inside the image (npm ci / pip install).
**/node_modules/
.venv/
venv/

# Built in-image; force-included into the wheel by hatchling.
devclaw/server/console_dist/

# Dev-harness worktrees + eval run artifacts — large, never needed at build.
.claude/worktrees/
evals/runs/

# Local editor/OS cruft.
.DS_Store
*.swp
